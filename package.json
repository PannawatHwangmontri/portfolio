{
  "name": "portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Monorepo for Developer Portfolio (Next.js + NestJS + Supabase)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo dev",
    "clean:ports": "npx --yes kill-port 3000 4000",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0"
  },
  "packageManager": "npm@11.6.2"
}
